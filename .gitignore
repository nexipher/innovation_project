# G7 入口 3 验收批次的图像（120 张，与 B 组源同编码）
calibration/set/images_acceptance/

# G7 批次变体：图像不入库，清单入库（与 sft_data/variants/ 同规矩）
sft_data/variants_*/*.png
sft_data/variants_*/*.jpg

# 归档副本里的变体图像同样不入库（清单与摘要见 archive/legacy_v1_20261015/MANIFEST.json）
archive/**/variants*/*.png
archive/**/variants*/*.jpg

# G8 评测产物的变体图像同样不入库（报告与分数入库，图像可重建）
sft_data/g8_eval/*/variants/*.png
sft_data/g8_eval/*/variants/*.jpg

# G8 双专家验收：最终批次的页面/records/trace 入库；原始 TruFor cache、
# 冒烟/对照/中断重跑只留本地，避免把临时产物和重复 npz 混进验收记录。
sft_data/g8_acceptance/*/trufor_raw/
sft_data/g8_acceptance/*_smoke/
sft_data/g8_acceptance/dual_*_check*/
sft_data/g8_acceptance/dual_check*/
sft_data/g8_acceptance/dual_*_partial_*/
sft_data/g8_acceptance/dual_*_orphan_*/
